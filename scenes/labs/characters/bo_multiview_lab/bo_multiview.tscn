[ext_resource type="PackedScene" path="res://scenes/labs/characters/bo_multiview_lab/view_front.tscn" id="2_front"]
[ext_resource type="PackedScene" path="res://scenes/labs/characters/bo_multiview_lab/view_front_3q.tscn" id="3_front3q"]
