[gd_scene format=3]

; NITA — MULTIVIEW CONTROLLER (LAB)
; Views: production front, new front 3/4, production side rig (animated),
; production back. (No back 3/4 yet — fallback chain handles it.)

[ext_resource type="Script" path="res://scripts/labs/multiview_controller.gd" id="1_ctrl"]
[ext_resource type="PackedScene" path="res://scenes/nita_front.tscn" id="2_front"]
[ext_resource type="PackedScene" path="res://scenes/labs/characters/nita_multiview_lab/view_front_3q.tscn" id="3_front3q"]
[ext_resource type="PackedScene" path="res://scenes/nita_side.tscn" id="4_side"]
[ext_resource type="PackedScene" path="res://scenes/nita_back.tscn" id="5_back"]

[node name="NitaMultiview" type="Node2D"]
script = ExtResource("1_ctrl")

[node name="ViewFront" parent="." instance=ExtResource("2_front")]

[node name="ViewFront3Q" parent="." instance=ExtResource("3_front3q")]

[node name="ViewSide" parent="." instance=ExtResource("4_side")]

[node name="ViewBack" parent="." instance=ExtResource("5_back")]
